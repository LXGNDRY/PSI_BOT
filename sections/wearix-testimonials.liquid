{% schema %}
{
  "name": "Wearix testimonials",
  "tag": "section",
  "class": "wearix-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The voice of quality"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "gray_bg",
      "label": "Gray background",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate testimonials",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "quote",
          "label": "Quote text",
          "default": "\"The quality is unmatched. Every piece feels like it was made just for you.\""
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Alex Morgan"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / location",
          "default": "New York, NY"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author avatar"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating (stars)",
          "default": 5,
          "min": 1,
          "max": 5,
          "step": 1
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "settings": {
        "heading": "The voice of quality",
        "show_stars": true,
        "gray_bg": true
      },
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "\"The quality is unmatched. Every piece feels like it was made just for you.\"",
            "author": "Alex Morgan",
            "role": "New York, NY",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.wearix-testimonials {
    padding: 120px 24px;
    text-align: center;
    background: #fff;
}

.wearix-testimonials--gray {
    background: #f7f7f7;
}

.wearix-testimonials__inner {
    max-width: 800px;
    margin: 0 auto;
}

.wearix-testimonials__heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 64px 0;
}

.wearix-testimonial {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.wearix-testimonial__stars {
    display: flex;
    gap: 4px;
    margin-bottom: 24px;
    color: #000;
}

.wearix-testimonial__star {
    width: 20px;
    height: 20px;
    fill: currentColor;
}

.wearix-testimonial__quote {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: #000;
    margin: 0 0 32px 0;
    max-width: 700px;
}

.wearix-testimonial__author {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
}

.wearix-testimonial__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
}

.wearix-testimonial__info {
    text-align: left;
}

.wearix-testimonial__name {
    font-size: 14px;
    font-weight: 500;
    margin: 0;
}

.wearix-testimonial__role {
    font-size: 13px;
    color: #707070;
    margin: 0;
}

@media (max-width: 768px) {
    .wearix-testimonials {
        padding: 80px 24px;
    }
}
{% endstylesheet %}

<section class="wearix-testimonials">
  <div class="wearix-testimonials__inner container">
    {% if section.settings.heading != blank %}
      <h2 class="wearix-testimonials__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% for block in section.blocks %}
      <div class="wearix-testimonial" id="testimonial-{{ block.id }}">
        {% if section.settings.show_stars %}
          <div class="wearix-testimonial__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {% assign rating = block.settings.rating | times: 1 %}
            {% for i in (1..5) %}
              <svg class="wearix-testimonial__star" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>
        {% endif %}
        <blockquote class="wearix-testimonial__quote">{{ block.settings.quote }}</blockquote>
        <div class="wearix-testimonial__author">
          {% if block.settings.avatar != blank %}
            <img class="wearix-testimonial__avatar"
                 src="{{ block.settings.avatar | img_url: '100x100' }}"
                 alt="{{ block.settings.author | escape }}"
                 loading="lazy" width="48" height="48">
          {% endif %}
          <div class="wearix-testimonial__info">
            <p class="wearix-testimonial__name">{{ block.settings.author | escape }}</p>
            <p class="wearix-testimonial__role">{{ block.settings.role | escape }}</p>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
