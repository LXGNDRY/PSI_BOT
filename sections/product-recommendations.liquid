{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "product-recommendations",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "default": 4,
      "min": 2,
      "max": 6,
      "step": 1,
      "unit": "products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Max products to show",
      "default": 4,
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "products"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "adapt",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "landscape",
          "label": "Landscape (3:2)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product recommendations",
      "settings": {
        "heading": "You may also like",
        "products_per_row": 4,
        "products_to_show": 4,
        "image_ratio": "adapt",
        "show_price": true
      },
      "blocks": []
    }
  ]
}
{% endschema %}

{% stylesheet %}
.product-recommendations {
  padding: 3rem 0;
  border-top: 1px solid var(--color-border, #eee);
}

.product-recommendations__heading {
  font-family: var(--font-heading-family);
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 600;
  margin: 0 0 2rem;
  text-align: center;
}

.product-recommendations__grid {
  display: grid;
  gap: var(--grid-gap, 1.5rem);
  grid-template-columns: repeat(2, 1fr);
}

.product-recommendations__grid[data-columns="3"] { grid-template-columns: repeat(3, 1fr); }
.product-recommendations__grid[data-columns="4"] { grid-template-columns: repeat(4, 1fr); }

.product-recommendations__placeholder .c-card__media {
  aspect-ratio: 4/5;
  background: var(--color-surface, #f5f5f5);
  border-radius: var(--radius-md, 8px);
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@media (max-width: 767px) {
  .product-recommendations__grid,
  .product-recommendations__grid[data-columns="3"],
  .product-recommendations__grid[data-columns="4"] {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (prefers-reduced-motion: reduce) {
  .product-recommendations__placeholder .c-card__media { animation: none; }
}
{% endstylesheet %}

<section
  class="product-recommendations"
  {{ section.shopify_attributes }}
  data-product-recommendations
>
  <div class="page-width">
    {%- if section.settings.heading -%}
      <h2 class="product-recommendations__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div
      class="product-recommendations__grid"
      data-columns="{{ section.settings.products_per_row }}"
      data-limit="{{ section.settings.products_to_show }}"
    >
      {%- for i in (1..section.settings.products_to_show) -%}
        <div class="product-recommendations__placeholder">
          <div class="c-card__media"></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
