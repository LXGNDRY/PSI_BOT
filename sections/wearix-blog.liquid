{% schema %}
{
  "name": "Wearix blog",
  "tag": "section",
  "class": "wearix-blog",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Style journal"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "View all button text",
      "default": "Read all blogs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "View all button link",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "gray_bg",
      "label": "Gray background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "blog_post",
      "name": "Blog post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Featured image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "How to build the perfect capsule wardrobe"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "Style Guide"
        },
        {
          "type": "text",
          "id": "excerpt",
          "label": "Excerpt",
          "default": ""
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog section",
      "settings": {
        "heading": "Style journal",
        "button_text": "Read all blogs",
        "gray_bg": false
      },
      "blocks": [
        {
          "type": "blog_post",
          "settings": {
            "category": "Style Guide",
            "title": "How to build the perfect capsule wardrobe",
            "date": "June 12, 2026"
          }
        },
        {
          "type": "blog_post",
          "settings": {
            "category": "Lookbook",
            "title": "Summer essentials for 2026",
            "date": "June 8, 2026"
          }
        },
        {
          "type": "blog_post",
          "settings": {
            "category": "Behind the scenes",
            "title": "The making of our premium denim",
            "date": "June 4, 2026"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.wearix-blog {
    padding: 120px 24px;
    background: #fff;
}

.wearix-blog--gray {
    background: #f7f7f7;
}

.wearix-blog__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
    flex-wrap: wrap;
    gap: 24px;
}

.wearix-blog__heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0;
}

.wearix-blog__grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 24px;
}

.wearix-blog__featured {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
}

.wearix-blog__featured-img {
    width: 100%;
    height: 100%;
    min-height: 500px;
    object-fit: cover;
    transition: transform 0.6s ease;
}

.wearix-blog__featured:hover .wearix-blog__featured-img {
    transform: scale(1.03);
}

.wearix-blog__featured-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px;
    background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
    color: #fff;
}

.wearix-blog__side {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.wearix-blog__side-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
}

.wearix-blog__side-img {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
}

.wearix-blog__side-content {
    flex: 1;
}

.wearix-blog__category {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #707070;
    margin: 0 0 8px 0;
}

.wearix-blog__featured .wearix-blog__category {
    color: rgba(255, 255, 255, 0.7);
}

.wearix-blog__title {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 8px 0;
    color: #000;
}

.wearix-blog__featured .wearix-blog__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: #fff;
    margin: 0 0 8px 0;
}

.wearix-blog__side-item .wearix-blog__title {
    font-size: 16px;
    line-height: 1.3;
}

.wearix-blog__date {
    font-size: 13px;
    color: #707070;
    margin: 0;
}

.wearix-blog__featured .wearix-blog__date {
    color: rgba(255, 255, 255, 0.6);
}

.wearix-blog__link {
    text-decoration: none;
    color: inherit;
    display: block;
}

.wearix-blog__read-all {
    display: inline-block;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    color: #000;
    border-bottom: 1px solid #000;
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
}

.wearix-blog__read-all:hover {
    opacity: 0.6;
}

@media (max-width: 900px) {
    .wearix-blog__grid {
        grid-template-columns: 1fr;
    }
    .wearix-blog__featured-img {
        min-height: 400px;
    }
    .wearix-blog__side {
        flex-direction: row;
        overflow-x: auto;
        gap: 16px;
        padding-bottom: 8px;
    }
    .wearix-blog__side-item {
        flex-direction: column;
        min-width: 240px;
        flex: 0 0 auto;
    }
    .wearix-blog__side-img {
        width: 100%;
        height: 200px;
    }
}

@media (max-width: 768px) {
    .wearix-blog {
        padding: 80px 24px;
    }
    .wearix-blog__header {
        flex-direction: column;
        align-items: flex-start;
    }
}
{% endstylesheet %}

<section class="wearix-blog">
  <div class="container">
    <div class="wearix-blog__header">
      {% if section.settings.heading != blank %}
        <h2 class="wearix-blog__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="wearix-blog__read-all">
          {{ section.settings.button_text | escape }}
        </a>
      {% endif %}
    </div>

    <div class="wearix-blog__grid">
      {% assign featured = section.blocks | first %}
      {% if featured != blank %}
        <a href="{{ featured.settings.link }}" class="wearix-blog__link wearix-blog__featured">
          {% if featured.settings.image != blank %}
            <img class="wearix-blog__featured-img"
                 src="{{ featured.settings.image | img_url: '1000x' }}"
                 alt="{{ featured.settings.title | escape }}"
                 loading="lazy" width="800" height="600">
          {% endif %}
          <div class="wearix-blog__featured-overlay">
            {% if featured.settings.category != blank %}
              <p class="wearix-blog__category">{{ featured.settings.category | escape }}</p>
            {% endif %}
            {% if featured.settings.title != blank %}
              <h3 class="wearix-blog__title">{{ featured.settings.title | escape }}</h3>
            {% endif %}
            {% if featured.settings.date != blank %}
              <p class="wearix-blog__date">{{ featured.settings.date | escape }}</p>
            {% endif %}
          </div>
        </a>
      {% endif %}

      <div class="wearix-blog__side">
        {% for block in section.blocks offset: 1 limit: 2 %}
          <a href="{{ block.settings.link }}" class="wearix-blog__link wearix-blog__side-item">
            {% if block.settings.image != blank %}
              <img class="wearix-blog__side-img"
                   src="{{ block.settings.image | img_url: '400x400' }}"
                   alt="{{ block.settings.title | escape }}"
                   loading="lazy" width="140" height="140">
            {% endif %}
            <div class="wearix-blog__side-content">
              {% if block.settings.category != blank %}
                <p class="wearix-blog__category">{{ block.settings.category | escape }}</p>
              {% endif %}
              {% if block.settings.title != blank %}
                <h4 class="wearix-blog__title">{{ block.settings.title | escape }}</h4>
              {% endif %}
              {% if block.settings.date != blank %}
                <p class="wearix-blog__date">{{ block.settings.date | escape }}</p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
